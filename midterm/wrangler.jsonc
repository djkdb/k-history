{
  // 중간고사 5과목 — 정적 결과(out-all/)를 그대로 서빙하고,
  // 기기 간 이어하기(/api/sync)만 작은 Worker 가 받는다 (worker/index.ts).
  "name": "zunte-midterm",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out-all",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    // 이 앱 전용 저장소 (다른 앱의 'zun' 과 따로)
    { "binding": "SYNC", "id": "0fa8426b39754b6fa3462e5b53ef0156" }
  ]
}
